# Optional bearer token. Leave blank for localhost-only development.
KESSEL_API_KEY=

# Comma-separated origins allowed to call the API from a separate frontend.
KESSEL_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Process controls.
KESSEL_REQUEST_TIMEOUT_SECONDS=300
KESSEL_MAX_CONCURRENT_REQUESTS=2
KESSEL_MAX_OUTPUT_BYTES=1048576

# Optional command overrides.
KESSEL_CODEX_COMMAND=codex
KESSEL_CLAUDE_COMMAND=claude
